{
  "name": "biz-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/smoke",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "bench:scale": "npm run build && node scripts/scale-bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@eventengine/core": "^0.1.0",
    "@eventengine/store": "^0.1.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "zod": "^3.25.76"
  }
}
